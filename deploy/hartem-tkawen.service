[Unit]
Description=hartem.tkawen.com — personal site in Rust (Axum + Maud)
Documentation=https://github.com/hartemyaakoub/hartem-tkawen-rs
After=network.target
Wants=network.target

[Service]
Type=exec
ExecStart=/usr/local/bin/hartem-tkawen-rs
Environment=HARTEM_ADDR=127.0.0.1:3088
Environment=RUST_LOG=info,tower_http=info
Restart=on-failure
RestartSec=2
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
PrivateTmp=yes
PrivateDevices=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
